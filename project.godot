; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[addons]

metroidvania_system/settings_file="res://SampleProject/Resources/Settings.tres"

[application]

config/name="metroidvania gamejam"
config/version="idk"
run/main_scene="res://scenes/opening/opening.tscn"
config/features=PackedStringArray("4.7")
config/icon="uid://bir818d8kuhpr"

[audio]

buses/default_bus_layout="uid://bmeavnkuyva0b"

[autoload]

MetSys="*uid://c01ibpvrp2wsd"
SceneLoader="*uid://cbwmrnp0af35y"
ProjectMusicController="*uid://r5t485lr3p7t"
ProjectUISoundController="*uid://cc37235kj4384"
PhantomCameraManager="*uid://duq6jhf6unyis"
SoundManager="*uid://6q1wagejt60k"
StartUp="*uid://cno5ujal5t3kf"
AppConfig="*uid://cjke6crjg14a0"
DialogueManager="*uid://c3rodes2l3gxb"

[debug]

gdscript/warnings/unassigned_variable=0
gdscript/warnings/unassigned_variable_op_assign=0
gdscript/warnings/unused_variable=0
gdscript/warnings/unused_local_constant=0
gdscript/warnings/unused_private_class_variable=0
gdscript/warnings/unused_parameter=0
gdscript/warnings/integer_division=0
gdscript/warnings/narrowing_conversion=0

[display]

window/size/viewport_width=864
window/size/viewport_height=480
window/size/always_on_top=true
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/stretch/scale_mode="integer"
window/per_pixel_transparency/allowed=true

[editor]

script/search_in_file_extensions=PackedStringArray("gd", "gdshader", "tscn")

[editor_plugins]

enabled=PackedStringArray("res://addons/GDQuest_GDScript_formatter/plugin.cfg", "res://addons/MetroidvaniaSystem/plugin.cfg", "res://addons/debug_menu/plugin.cfg", "res://addons/dialogue_manager/plugin.cfg", "res://addons/godot_state_charts/plugin.cfg", "res://addons/godotresourcecleaner/plugin.cfg", "res://addons/maaacks_game_template/plugin.cfg", "res://addons/phantom_camera/plugin.cfg", "res://addons/plugin_updater/plugin.cfg", "res://addons/project-time-tracker/plugin.cfg", "res://addons/script-ide/plugin.cfg", "res://addons/sound_manager/plugin.cfg")

[file_customization]

folder_colors={
"res://SampleProject/": "gray",
"res://addons/": "gray",
"res://demo/": "gray",
"res://godot_state_charts_examples/": "gray"
}

[filesystem]

import/blender/enabled=false

[gui]

theme/custom="uid://bac1khm2nmjl3"

