disable_install_wizard=true
main_menu_scene_path="res://scenes/menus/main_menu/main_menu.tscn"
game_scene_path="res://scenes/game/dean_main_test.tscn"
ending_scene_path="res://scenes/end_credits/end_credits.tscn"
copy_path="res://"
disable_update_check=false

[plugin_updater]

plugins={}

[project_time_traker]

